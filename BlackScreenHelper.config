# =======================================================
# 远程黑屏助手 配置文件（改完后重启程序生效）
# =======================================================
# 检测模式：Manual(手动) / Process(进程) / Window(窗口)
Mode=Manual

# 黑屏方式：Overlay(覆盖层,默认) / MonitorOff(关闭显示器)
BlackScreenMethod=Overlay

# 需要监视的进程名（Process 模式用，可多行）
Process=SunloginClient.exe
Process=ToDesk.exe

# 需要匹配的窗口标题关键字（Window 模式用，可多行）

# 需要匹配的窗口类名关键字（Window 模式用，可留空）

# 是否开机自启：1 / 0
AutoStart=0
# 学习模式（窗口侦探）：1 / 0
LearnMode=0

# 全局热键（例如 Control+Alt+B）
Hotkey=Control+Alt+B
